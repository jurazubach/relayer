{
  "_about": {
    "what": "Единственное место чисел и порогов relayer: проверки story:lint (C-NN), общие пределы истории (story.*), движок (engine.*), линт (lint.*), словари проверок (dict.*), лаборатория (lab.*) и контракт скиллов (skill.*). В остальных файлах — только ключ.",
    "fields": {
      "value": "число, строка (регулярка словаря) или объект",
      "unit": "единица значения",
      "op": "условие срабатывания: значение замера op value → находка (необязательное)",
      "level": "error | warning | hint — уровень находки; null — определение, словарь или настройка",
      "basis": "source — опора в источнике; our_estimate — наша оценка",
      "sources": "алиас:ID разборов, правила rules.md, файлы",
      "checks": "проверки, которые читают ключ, если ключ не привязан к одной проверке",
      "calibrated_on": "на чём откалиброван порог или null",
      "history": "правки: дата, задача, что было"
    },
    "keys": "C-NN.<имя> — порог одной проверки; <область>.<имя> — общий порог с полем checks",
    "levels": "ошибка — код выхода 1 у story:lint --strict; предупреждение; подсказка",
    "calibration": "Ни один порог не проверен на живых игроках. Прогон первой волны — checks.md, «Прогон первой волны по трём историям»."
  },

