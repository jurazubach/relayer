{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "1auth@pls-mngd-marketplace": false,
    "engineer@pls-mngd-marketplace": false,
    "logs-harness@pls-mngd-marketplace": false,
    "teleport@pls-mngd-marketplace": false,
    "brightdata-plugin@synced": false,
    "cockroachdb@synced": false,
    "engineering@synced": false
  },
  "disableClaudeAiConnectors": true,
  "permissions": {
    "allow": [
      "Skill",
      "Bash(npm run story*)",
      "Bash(npm run -s story*)",
      "Bash(npm run -s check:story*)",
      "Bash(npm run check:story*)",
      "Bash(node scripts/hooks/full.mjs *)",
      "Bash(node scripts/story/*)",
      "Bash(node .claude/skills/*)",
      "Bash(node */.claude/skills/*)",
      "Bash(rm docs/stories/*/context-ch*.md)"
    ]
  },
  "skillOverrides": {
    "pls-mngd-cicd-troubleshooting": "off",
    "pls-mngd-collect-github-rulesets": "off",
    "pls-mngd-gitbook": "off",
    "pls-mngd-github-template-with-rulesets": "off",
    "pls-mngd-spdd": "off",
    "travel-assistant": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "claude-api": "name-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-start.mjs",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
