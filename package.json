{
  "name": "relay-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/story-pack.mjs --quiet",
    "preview": "vite preview",
    "check:story": "node scripts/check-story.mjs",
    "graph": "node scripts/story-graph.mjs",
    "story:pack": "node scripts/story-pack.mjs",
    "story:unpack": "node scripts/story-pack.mjs --unpack",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "shots": "playwright test e2e/shots.spec.ts",
    "prompt": "node scripts/build-prompt.mjs",
    "kb:clean": "node scripts/kb/clean.mjs",
    "test:kb:clean": "node --test scripts/kb/clean.test.mjs",
    "test:lib": "node scripts/lib/selftest.mjs",
    "lab:triggers": "node scripts/lab/triggers.mjs",
    "test:lab:triggers": "node --test scripts/lab/triggers.test.mjs",
    "skills:test": "node scripts/lab/skills-test.mjs",
    "test:lab:mutants": "node --test scripts/lab/mutants.test.mjs",
    "story:trace": "node scripts/story/trace.mjs",
    "story:vars": "node scripts/story/vars.mjs",
    "story:sessions": "node scripts/story/sessions.mjs",
    "story:cast": "node scripts/story/cast.mjs",
    "story:endings": "node scripts/story/endings.mjs",
    "story:diff": "node scripts/story/diff.mjs",
    "story:rule": "node scripts/story/rule.mjs",
    "story:status": "node scripts/story/status.mjs",
    "story:cold-read": "node scripts/story/cold-read.mjs",
    "test:story-cmd": "node scripts/story/selftest.mjs",
    "story:lint": "node scripts/lint/lint.mjs",
    "test:lint": "node scripts/lint/selftest.mjs",
    "test:hooks": "node scripts/hooks/selftest.mjs",
    "story:coverage": "node scripts/kb/coverage.mjs",
    "test:coverage": "node --test scripts/kb/coverage.test.mjs"
  },
  "dependencies": {
    "inkjs": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
