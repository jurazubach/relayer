// THE NUMBER · Пакет 01 · Last Errand · День 1
//
// Как читать теги (пишутся в конце строки или на строке над ней):
//   #from:theo     сообщение от контакта theo (говорящий «липкий» до следующего from)
//   #me:hold       исходящее сообщение игрока в чат hold
//   #sys           системная строка в текущем чате («Доставлено», «не в сети»)
//   #photo         строка показывается как фото
//   #delay:12m     пауза перед строкой (s, m, h). Ускоряется в панели отладки
//   #unlock:dina   открыть новый контакт
//
// Глобальные теги ниже описывают контакты: id, имя, цвет.

# title: Last Errand · День 1
# contact: theo, Тео, blue
# contact: dina, Дина, amber
# contact: hold, HOLD, red
# contact: unknown, Неизвестный номер, grey

VAR played_dumb = false
VAR has_label_photo = false
VAR has_laundry_address = false
VAR box_hidden = false
VAR met_dina = false
VAR hold_contacted = false
VAR theo_trust = 0

-> theo_intro

